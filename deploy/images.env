# Prebuilt images published by .github/workflows/publish.yml.
#
# deploy.sh --from-registry (and IMAGE_SOURCE=registry) read this file to decide
# what to pull, so `deploy.sh` on an Apple Silicon / arm64 Linux host works with no
# local build and no x86_64 emulation.
#
# Maintainers: bump VERSION in the same commit that creates the release tag.
# publish.yml emits a warning at build time if the tag and this value disagree.
#
# Override at run time without editing this file:
#   PROVINGPOD_VERSION=v0.2.0 sudo ./deploy/deploy.sh --from-registry
#   GATEWAY_IMAGE=... USERENV_IMAGE=... sudo ./deploy/deploy.sh --skip-build

REGISTRY="${REGISTRY:-ghcr.io/yctech2026}"
VERSION="${VERSION:-v0.1.0}"

GATEWAY_IMAGE_NAME="provingpod-gateway"
POD_IMAGE_NAME="provingpod-pod"
